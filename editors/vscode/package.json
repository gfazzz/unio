{
  "name": "unio",
  "displayName": "Unio",
  "description": "Unio for VS Code and Cursor: highlighting of .unio files and of ```unio blocks of Markdown, and the language server unio lsp (diagnostics, go to definition, hover with types, completion, formatting, rename).",
  "version": "0.2.0",
  "publisher": "unio",
  "license": "SEE LICENSE IN README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/gfazzz/unio"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:unio"
  ],
  "contributes": {
    "languages": [
      {
        "id": "unio",
        "aliases": [
          "Unio",
          "unio"
        ],
        "extensions": [
          ".unio"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/unio-light.svg",
          "dark": "./icons/unio-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "unio",
        "scopeName": "source.unio",
        "path": "./syntaxes/unio.tmLanguage.json"
      },
      {
        "scopeName": "markdown.unio.codeblock",
        "path": "./syntaxes/unio.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.unio": "unio"
        }
      }
    ],
    "configuration": {
      "title": "Unio",
      "properties": {
        "unio.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the language server unio lsp for .unio files."
        },
        "unio.server.path": {
          "type": "string",
          "default": "unio",
          "description": "The unio executable that runs the language server (unio lsp)."
        },
        "unio.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments after 'unio lsp', for example [\"--policy\", \"/path/to/policy.toml\"]: the [compile] table of the policy limits every analysis worker."
        }
      }
    },
    "commands": [
      {
        "command": "unio.restartServer",
        "title": "Unio: Restart the language server"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/grammar.test.mjs test/client.test.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}
