{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "folding": {
    "offSide": true
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|-?[0-9][0-9_]*(?:\\.[0-9_]+)?",
  "indentationRules": {
    "increaseIndentPattern": "^.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(else|case|on)\\b.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^.*:\\s*(#.*)?$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(return|fail|break|continue|pass)\\b.*$",
      "action": {
        "indent": "outdent"
      }
    }
  ]
}
