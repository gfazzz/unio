## Шаг 1 руководства (docs/ru/guide.md, глава 3): задачи как значения в списке.
##
## Использование:
##     unio run todo_1_tasks.unio

struct Task:
    public id as Int
    public title as Text
    public var done as Bool = false

## Номер новой задачи: на единицу больше наибольшего номера в списке.
function next_id(tasks as List[Task]) returns Int:
    return (tasks.map(function (task): task.id).max() or 0) + 1

## Добавляет задачу в список вызывающего; var делает изменение видимым в месте вызова.
function add_task(var tasks as List[Task], title as Text):
    tasks.append(Task(id = next_id(tasks), title = title))

## Одна строка списка: "[x] 2. купить хлеб".
function render(task as Task) returns Text:
    let mark = "x" if task.done else " "
    return "[{mark}] {task.id}. {task.title}"

public function main():
    var tasks as List[Task] = []
    add_task(tasks, "купить хлеб")
    add_task(tasks, "написать руководство")
    tasks[0].done = true
    for task in tasks:
        print(render(task))

test "номера растут с единицы":
    var tasks as List[Task] = []
    assert next_id(tasks) == 1
    add_task(tasks, "a")
    add_task(tasks, "b")
    assert tasks.map(function (task): task.id) == [1, 2]

test "задача — значение: копия не меняет список":
    var tasks as List[Task] = []
    add_task(tasks, "a")
    var copy = tasks[0]
    copy.done = true
    assert not tasks[0].done
    tasks[0].done = true
    assert render(tasks[0]) == "[x] 1. a"
