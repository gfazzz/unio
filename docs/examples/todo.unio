## Command-line task list. Stores tasks in a JSON file in the home directory.
##
## Usage:
##     todo add "buy bread"
##     todo done 3
##     todo list

import std.args
import std.files
import std.json as json
import std.env
from std.text import join

struct Task:
    id as Int
    title as Text
    var done as Bool = false

enum Command:
    Add(title as Text)
    Done(id as Int)
    List
    Help

error StorageError:
    path as Path
    reason as Text

error UsageError:
    message as Text

## Storage path: $TODO_FILE or ~/.todo.json.
function storage_path() returns Path:
    match env.get("TODO_FILE"):
        case some(value):
            return Path(value)
        case none:
            return env.home_dir().join(".todo.json")

function load_tasks(path as Path) returns List[Task] fails with StorageError:
    if not files.exists(path):
        return []
    let text = try files.read_text(path) on IoError as e:
        fail StorageError(path = path, reason = e.reason)
    let value = try json.parse(text) on ParseError as e:
        fail StorageError(path = path, reason = "corrupted JSON: {e.message}")
    return try json.decode[List[Task]](value) on DecodeError as e:
        fail StorageError(path = path, reason = e.message)

function save_tasks(path as Path, tasks as List[Task]) fails with StorageError:
    let text = json.encode(tasks, pretty = true)
    try files.write_text(path, text) on IoError as e:
        fail StorageError(path = path, reason = e.reason)

function parse_command(arguments as List[Text]) returns Command fails with UsageError:
    match arguments:
        case ["add", rest...] if not rest.is_empty():
            return Add(title = join(rest, " "))
        case ["done", id_text]:
            match id_text.to_int():
                case some(id):
                    return Done(id = id)
                case none:
                    fail UsageError(message = "task number must be an integer: {id_text}")
        case ["list"]:
            return List
        case ["help"] | []:
            return Help
        case _:
            fail UsageError(message = "unknown command: {join(arguments, " ")}")

function next_id(tasks as List[Task]) returns Int:
    return (tasks.map(function (task as Task) returns Int: task.id).max() or 0) + 1

function run(command as Command, path as Path) fails with StorageError, UsageError:
    var tasks = try load_tasks(path)
    match command:
        case Add(title):
            tasks.append(Task(id = next_id(tasks), title = title))
            try save_tasks(path, tasks)
            print("Added: {title}")
        case Done(id):
            match tasks.find(function (task as Task) returns Bool: task.id == id):
                case some(task):
                    task.done = true
                    try save_tasks(path, tasks)
                    print("Done: {task.title}")
                case none:
                    fail UsageError(message = "no task with number {id}")
        case List:
            if tasks.is_empty():
                print("No tasks")
            for task in tasks:
                let mark = "x" if task.done else " "
                print("[{mark}] {task.id}. {task.title}")
        case Help:
            print("Commands: add <text>, done <number>, list, help")

public function main() returns Int:
    try:
        let command = parse_command(args.list())
        run(command, storage_path())
        return 0
    on UsageError as e:
        print_error("Error: {e.message}")
        return 2
    on StorageError as e:
        print_error("Storage {e.path}: {e.reason}")
        return 1

test "parse_command recognizes add":
    let command = try parse_command(["add", "buy", "bread"]) on UsageError as e:
        assert_fail(e.message)
    assert command == Add(title = "buy bread")

test "parse_command rejects a non-numeric number":
    match parse_command(["done", "abc"]):
        case ok(_):
            assert_fail("expected an error")
        case error(UsageError as e):
            assert e.message.contains("must be an integer")

test "next_id for an empty list":
    assert next_id([]) == 1
