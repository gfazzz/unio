## Contextual keywords are ordinary names outside the positions where the grammar uses them.

error Failure:
    message as Text

struct Report:
    error as Option[Text]
    test as Text
    module as Text

function describe(report as Report, unsafe as Bool, external as Bool) returns Text:
    let error = report.error or "none"
    match report.error:
        case some(text): print(text)
        case none: pass
    if unsafe and not external: pass
    return "{report.module}: {report.test}: {error}"

test "a test block still starts with test":
    assert describe(Report(error = none, test = "t", module = "m"), false, false) == "m: t: none"
