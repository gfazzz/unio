## Expressions: precedence, comparisons, collections, functions, options, generics.

function arithmetic(a as Int, b as Int, x as Float) returns Bool:
    let sum = a + b * 2 - (a - b) / 3 % 4
    let power = -a ** 2
    let tower = 2 ** 3 ** 2
    let mixed = x * 2.0 + 1.0
    let logic = not a > b and b != 0 or a == 1
    let member = a in [1, 2, 3] and b not in [4, 5]
    let choice = "big" if a > 100 else "small" if a > 10 else "tiny"
    return sum >= power and logic

function collections(users as List[User]) returns Map[Text, Int]:
    let names = [user.name for user in users if user.active]
    let pairs = [(index, user.id) for index, user in users.enumerate()]
    let empty_list as List[Int] = []
    let ages = {"anna": 31, "boris": 42}
    let nothing as Map[Text, Int] = {}
    let single = (1,)
    let nested = [[1, 2], [3, 4]][0][1]
    return ages

function functions(users as List[User]) returns List[Int]:
    let double = function (x as Int) returns Int: x * 2
    let ids = users.map(function (user as User) returns Int: user.id)
    let total = ids.reduce(0, function (acc as Int, id as Int) returns Int: acc + id)
    expect_fault(function (): ids[100])
    return ids.map(double)

function options(id as Int) returns Text:
    let user = find_user(id) or default_user()
    let name = find_user(id)?.profile?.display_name or "anonymous"
    let decoded = try json.decode[List[Task]](value) on DecodeError as e:
        return e.message
    let table = cache.get[Map[Text, Int]](key)
    let item = items[index]
    return "{user.name}: {name}"

function calls() returns User:
    connect("localhost", port = 8080, secure = true)
    return User(id = 1, name = "Anna")
