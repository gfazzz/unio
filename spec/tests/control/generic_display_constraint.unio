# expect-error: 17 E0062
# category: types
struct Coordinate:
    lat as Float
    lon as Float

function coordinate_text(point as Coordinate) returns Text:
    return "({point.lat}, {point.lon})"

function bullet_list[T with Display](items as List[T]) returns Text:
    var text = ""
    for item in items:
        text = text + "* {item}\n"
    return text

function route(stops as List[Coordinate]) returns Text:
    return bullet_list(stops)
