# expect-error: 16 E0081
# category: resources
struct Meter:
    name as Text
    var readings as List[Int]

extend Meter with Resource:
    function release(var self):
        print("meter {self.name} closed")

function open_meter(name as Text) returns Meter:
    return Meter(name = name, readings = [3, 5, 8])

function average_reading(name as Text) returns Int:
    using meter = open_meter(name):
        let read = function () returns List[Int]: meter.readings
        var sum = 0
        for reading in read():
            sum = sum + reading
        return sum / meter.readings.length()
