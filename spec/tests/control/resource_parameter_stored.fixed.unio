struct Lock:
    name as Text
    var held as Int

extend Lock with Resource:
    function release(var self):
        print("unlocked {self.name}")

extend Lock:
    function guard(var self, work as Text) returns Text:
        self.held = self.held + 1
        return "{self.name}: {work}"

function acquire(name as Text) returns Lock:
    return Lock(name = name, held = 0)

struct Audit:
    lock_name as Text
    entry as Text

function audit(var lock as Lock, entry as Text) returns Audit:
    return Audit(lock_name = lock.name, entry = lock.guard(entry))

function audited(name as Text) returns Text:
    using lock = acquire(name):
        return audit(lock, "check").entry
