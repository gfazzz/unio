enum Grade:
    Excellent
    Good
    Pass
    Fail

function grade(score as Int) returns Grade:
    if score >= 90: return Grade.Excellent
    if score >= 75: return Grade.Good
    if score >= 50: return Grade.Pass
    return Grade.Fail

function label(score as Int) returns Text:
    match grade(score):
        case Grade.Excellent: return "A"
        case Grade.Good: return "B"
        case Grade.Pass: return "C"
        case Grade.Fail: return "F"
