struct Lock:
    name as Text
    var held as Int

extend Lock with Resource:
    function release(var self):
        print("unlocked {self.name}")

extend Lock:
    function guard(var self, work as Text) returns Text:
        self.held = self.held + 1
        return "{self.name}: {work}"

function acquire(name as Text) returns Lock:
    return Lock(name = name, held = 0)

struct Job:
    title as Text
    lock_name as Text

function run(job as Job) returns Text:
    using lock = acquire(job.lock_name):
        return lock.guard(job.title)
