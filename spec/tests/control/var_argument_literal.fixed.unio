function sort_in_place(var values as List[Int]):
    var index = 1
    while index < values.length():
        var position = index
        while position > 0 and values[position - 1] > values[position]:
            let swap = values[position]
            values[position] = values[position - 1]
            values[position - 1] = swap
            position = position - 1
        index = index + 1

function sorted_sample() returns List[Int]:
    var sample = [5, 2, 9, 1]
    sort_in_place(sample)
    return sample
