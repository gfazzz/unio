struct Connection:
    host as Text
    var sent as List[Text]

extend Connection with Resource:
    function release(var self):
        print("closing {self.host} after {self.sent.length()} messages")

extend Connection:
    function send(var self, message as Text) returns Int:
        self.sent.append(message)
        return message.length()

function connect(host as Text) returns Connection:
    return Connection(host = host, sent = [])

function send_twice(var connection as Connection, message as Text) returns Int:
    return connection.send(message) + connection.send(message)

function chat(host as Text) returns Int:
    using connection = connect(host):
        return send_twice(connection, "hi")
