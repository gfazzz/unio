function move_done(var pending as List[Text], var done as List[Text], task as Text):
    var kept as List[Text] = []
    for item in pending:
        if item == task: done.append(item)
        else: kept.append(item)
    pending = kept

function finish(var todo as List[Text], task as Text) returns List[Text]:
    var done as List[Text] = []
    move_done(todo, done, task)
    return done
