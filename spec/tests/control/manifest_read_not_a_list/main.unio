import std.args
import std.files

# Prints the number of lines of each file named on the command line.
function count_lines(text as Text) returns Int:
    return text.lines().length()

public function main() returns Int:
    for name in args.list():
        let text = try files.read_text(Path(name)) on IoError as e:
            print_error("{name}: {e.reason}")
            return 1
        print("{name}: {count_lines(text)}")
    return 0
