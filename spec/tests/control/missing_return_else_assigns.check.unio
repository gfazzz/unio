# Hidden behavioural check of missing_return_else_assigns: test blocks that the reference fix passes.

test "fizzbuzz words":
    assert [fizzbuzz(n) for n in range(1, 16)] == [
        "1",
        "2",
        "Fizz",
        "4",
        "Buzz",
        "Fizz",
        "7",
        "8",
        "Fizz",
        "Buzz",
        "11",
        "Fizz",
        "13",
        "14",
        "FizzBuzz",
    ]
