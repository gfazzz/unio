# expect-error: 21 E0081
# category: resources
struct Lock:
    name as Text
    var held as Int

extend Lock with Resource:
    function release(var self):
        print("unlocked {self.name}")

extend Lock:
    function guard(var self, work as Text) returns Text:
        self.held = self.held + 1
        return "{self.name}: {work}"

function acquire(name as Text) returns Lock:
    return Lock(name = name, held = 0)

function open_named(prefix as Text, id as Int) returns Lock:
    using lock = acquire("{prefix}-{id}"):
        return lock

function job_label(id as Int) returns Text:
    using lock = open_named("job", id):
        return lock.guard("start")
