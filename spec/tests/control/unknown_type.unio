# expect-error: 7 E0056
# category: types
struct Order:
    id as Int
    total_cents as Int

function largest(orders as List[Orders]) returns Option[Order]:
    var best as Option[Order] = none
    for order in orders:
        match best:
            case some(current):
                if order.total_cents > current.total_cents: best = some(order)
            case none: best = some(order)
    return best
