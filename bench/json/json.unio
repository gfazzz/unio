## Benchmark (b): parse a JSON document with std.json and encode it again; prints the UTF-8 size.
import std.args
import std.files
import std.json as json

public function main() returns Int:
    let name = args.list().first() or ""
    let text = try files.read_text(Path(name)) on IoError as e:
        print_error(e.reason)
        return 1
    let value = try json.parse(text) on ParseError as e:
        print_error(e.message)
        return 1
    print("{json.encode(value).byte_length()}")
    return 0
