## Programs that `unio check` accepts must run as the check typed them: maps are visited as
## (key, value) pairs, a field of a value inside a map changes in place, and decoding takes its
## target type from the expected type when the call writes none (tests/interpreter.rs and
## tests/native.rs run this file).

import std.json as json

struct Book:
    public title as Text
    public var borrower as Int = 0

## A type parameter that reaches decoding through a function of the program.
function load[T](text as Text) returns T fails with ParseError, DecodeError:
    return try json.decode(try json.parse(text))

public function main() returns Int:
    let ages = {"anna": 30, "boris": 41}
    for name, age in ages:
        print("{name} {age}")
    let older = [name for name, age in ages if age > 35]
    print("older {older.length()} {older[0]}")
    var books as Map[Int, Book] = {1: Book(title = "Dune"), 2: Book(title = "Emma")}
    books[2].borrower = 7
    print("borrowers {books[1].borrower} {books[2].borrower}")
    let text = "[\{\"title\": \"Dune\", \"borrower\": 3\}]"
    let value = try json.parse(text) on ParseError as e:
        print_error(e.message)
        return 1
    let decoded as List[Book] = try json.decode(value) on DecodeError as e:
        print_error(e.message)
        return 1
    print("decoded {decoded.length()} {decoded[0].title} {decoded[0].borrower}")
    try:
        let numbers as List[Int] = load("[1, 2, 3]")
        print("loaded {numbers.length()} {numbers[2] * 2}")
    on ParseError as e:
        print_error(e.message)
        return 1
    on DecodeError as e:
        print_error(e.message)
        return 1
    return 0

## Changes a book that the map does not have.
function lend_missing():
    var books as Map[Int, Book] = {1: Book(title = "Dune")}
    books[9].borrower = 1

test "a missing key of a map place is a fault":
    expect_fault(function (): lend_missing())
