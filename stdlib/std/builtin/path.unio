## Lexical paths. "/" is accepted on every platform; "\\" separates components only on Windows.
## Anchors preserve POSIX roots, Windows drive-relative/rooted paths and UNC server/share roots.
unsafe module

from std.text import join, split

## A path from its text, as given; nothing is checked or normalized.
## Example:
##     assert Path("a/b").to_text() == "a/b"
public external function Path(text as Text) returns Path

extend Path with Display:
    external function to_text(self) returns Text

struct PathParts:
    anchor as Text
    items as List[Text]

extend Path:
    ## The anchor, if present, then names. Examples: ["/", "a"], ["C:", "a"], ["C:/", "a"].
    ## UNC roots are one anchor such as "//server/share/", never ordinary directory names.
    ## Example:
    ##     assert Path("/usr/lib").components() == ["/", "usr", "lib"]
    public function components(self) returns List[Text]:
        let parsed = parse_parts(self.to_text(), separator() == "\\")
        var result as List[Text] = []
        if not parsed.anchor.is_empty(): result.append(parsed.anchor)
        result.append_all(parsed.items)
        return result

    ## Whether the path starts at a root: "/" on Linux and macOS; a drive with a root ("C:\\") or a
    ## UNC share on Windows.
    ## Example:
    ##     assert not Path("a/b").is_absolute()
    public function is_absolute(self) returns Bool:
        let windows = separator() == "\\"
        return absolute_parts(parse_parts(self.to_text(), windows), windows)

    ## The last name; "" for an empty path, a drive anchor or a root.
    ## Example:
    ##     assert Path("dir/file.txt").name() == "file.txt"
    public function name(self) returns Text:
        return parse_parts(self.to_text(), separator() == "\\").items.last() or ""

    ## Text after the last dot; a leading dot alone does not introduce an extension.
    ## Example:
    ##     assert Path("a/report.tar.gz").extension() == "gz" and Path(".profile").extension() == ""
    public function extension(self) returns Text:
        let name = self.name()
        var position = -1
        for index, character in name.chars().enumerate():
            if character == "." and index > 0: position = index
        if position < 0: return ""
        return name.slice(position + 1, name.length())

    ## Remove the last name; none at a root/drive anchor. UNC parents never leave the share.
    ## Example:
    ##     assert Path("a/b.txt").parent() == some(Path("a"))
    public function parent(self) returns Option[Path]:
        let parsed = parse_parts(self.to_text(), separator() == "\\")
        if parsed.items.is_empty(): return none
        return some(
            Path(
                render_parts(
                    PathParts(
                        anchor = parsed.anchor,
                        items = parsed.items.slice(0, parsed.items.length() - 1),
                    ),
                ),
            ),
        )

    ## Append text without changing the anchor. This is not a sandbox containment check.
    ## Example:
    ##     assert Path("a").join("b.txt") == Path("a{separator()}b.txt")
    public function join(self, part as Text) returns Path:
        let text = self.to_text()
        let parsed = parse_parts(text, separator() == "\\")
        if text.is_empty() or text.ends_with("/") or (separator() == "\\" and text.ends_with("\\")):
            return Path(text + part)
        if parsed.items.is_empty() and parsed.anchor.ends_with(":"): return Path(text + part)
        return Path(text + separator() + part)

    ## Remove "." and redundant separators, preserving ".." and the anchor.
    ## This does not resolve symlinks or prove filesystem equivalence; use files.resolve for resolution.
    ## Example:
    ##     assert Path("a/./b//c").normalize() == Path("a/b/c")
    public function normalize(self) returns Path:
        let parsed = parse_parts(self.to_text(), separator() == "\\")
        let names = [part for part in parsed.items if part != "."]
        return Path(render_parts(PathParts(anchor = parsed.anchor, items = names)))

function parse_parts(source as Text, windows as Bool) returns PathParts:
    let text = source.replace("\\", "/") if windows else source
    var anchor = ""
    var start = 0
    if windows and text.length() >= 2 and text.slice(
        1,
        2,
    ) == ":" and "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(
        text.slice(0, 1),
    ):
        anchor = text.slice(0, 2)
        start = 2
        if text.length() > 2 and text.slice(2, 3) == "/":
            anchor = anchor + "/"
            start = 3
    else if text.starts_with("//") and not text.starts_with("///"):
        let names = [name for name in split(
            text.slice(2, text.length()),
            "/",
        ) if not name.is_empty()]
        if windows and names.length() >= 2:
            return PathParts(
                anchor = "//{names[0]}/{names[1]}/",
                items = names.slice(2, names.length()),
            )
        return PathParts(anchor = "//", items = names)
    else if text.starts_with("/"):
        anchor = "/"
        start = 1
    return PathParts(
        anchor = anchor,
        items = [name for name in split(
            text.slice(start, text.length()),
            "/",
        ) if not name.is_empty()],
    )

function absolute_parts(parsed as PathParts, windows as Bool) returns Bool:
    if not windows: return parsed.anchor.starts_with("/")
    return parsed.anchor.ends_with(":/") or (parsed.anchor.starts_with(
        "//",
    ) and parsed.anchor.length() > 2)

function render_parts(parsed as PathParts) returns Text:
    let text = parsed.anchor + join(parsed.items, "/")
    return "." if text.is_empty() else text

## "/" on Linux and macOS, "\\" on Windows.
external function separator() returns Text

test "lexical normalization preserves a possible symlink traversal":
    assert Path("link/../file").normalize().components() == ["link", "..", "file"]
    assert Path("a/./b").normalize().components() == ["a", "b"]

test "Windows drive-relative, drive-rooted and UNC anchors remain distinct":
    let relative = parse_parts("C:folder/../file", true)
    assert relative.anchor == "C:"
    assert not absolute_parts(relative, true)
    assert render_parts(relative) == "C:folder/../file"
    let rooted = parse_parts("C:\\folder\\file", true)
    assert rooted.anchor == "C:/"
    assert absolute_parts(rooted, true)
    let share = parse_parts("\\\\server\\share\\folder", true)
    assert share.anchor == "//server/share/"
    assert share.items == ["folder"]
    assert absolute_parts(share, true)
    assert render_parts(share) == "//server/share/folder"
    assert not absolute_parts(parse_parts("/folder", true), true)
    assert not absolute_parts(parse_parts("//server", true), true)

test "POSIX preserves backslashes as names and exactly two leading slashes":
    let path = parse_parts("/a\\b/../c", false)
    assert path.items == ["a\\b", "..", "c"]
    assert absolute_parts(path, false)
    assert parse_parts("//host/path", false).anchor == "//"
    assert parse_parts("///host/path", false).anchor == "/"

test "root and ordinary relative parents":
    assert Path("/").parent() == none
    assert Path("/").name() == ""
    assert Path("name").parent() == some(Path("."))
