## Operations that combine or split several texts. Methods of a single text are in builtin/text.unio.
unsafe module

## The parts with the separator between each two of them.
public function join(parts as List[Text], separator as Text) returns Text:
    var result = ""
    for index, part in parts.enumerate():
        if index > 0: result = result + separator
        result = result + part
    return result

## The text cut at every occurrence of the separator; an empty separator is a fault.
## split("a.b", ".") is ["a", "b"] and split("", ".") is [""].
public function split(text as Text, separator as Text) returns List[Text]:
    assert not separator.is_empty()
    var parts as List[Text] = []
    var start = 0
    while true:
        match text.index_of(separator, start = start):
            case some(position):
                parts.append(text.slice(start, position))
                start = position + separator.length()
            case none:
                parts.append(text.slice(start, text.length()))
                return parts

## The character with the code point; none for a surrogate or a value above 0x10FFFF.
public external function from_code_point(code as Int) returns Option[Text]

test "join and split are inverse":
    assert split(join(["a", "b", "c"], ", "), ", ") == ["a", "b", "c"]

test "split keeps empty parts":
    assert split("a..b", ".") == ["a", "", "b"]
